# Copy to .env and fill in. NEVER commit .env.
# Load it with e.g.:  set -a; . ./.env; set +a

# dummy | live
SOURCE=dummy

# Required when SOURCE=live
KNVB_USER=your-knvb-login@example.org
KNVB_PASS=CHANGEME
KNVB_CLIENT_ID=CHANGEME
KNVB_CLIENT_SECRET=CHANGEME

TEAM_ID=T1779014083
ONLY_OWN_TEAM=false
INCLUDE_PAST=false

# Required unless DRY_RUN=1
R2_ACCOUNT_ID=CHANGEME
R2_ACCESS_KEY_ID=CHANGEME
R2_SECRET_ACCESS_KEY=CHANGEME
R2_BUCKET=CHANGEME
# Include a long random path segment: the URL is the only access control.
R2_OBJECT_KEY=CHANGEME-random-segment/neptunus-o8-1.ics

CAL_NAME=Neptunus-Schiebroek O8-1
DEFAULT_DURATION=1h
RETAIN_DAYS=180

# Optional ntfy topic URL, e.g. https://ntfy.sh/CHANGEME-random-topic
NOTIFY_URL=

DRY_RUN=1
OUT_DIR=./out
ALLOW_EMPTY=false
LOG_LEVEL=info
